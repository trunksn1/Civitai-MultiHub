{
  "manifest_version": 3,
  "name": "MultiHub for Civitai - Unofficial",
  "version": "0.13.0",
  "description": "Create combined Civitai media feeds from selected creators, models, model versions, and public collections.",
  "icons": {
    "16": "icons/multihub-16.png",
    "32": "icons/multihub-32.png",
    "48": "icons/multihub-48.png",
    "128": "icons/multihub-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://civitai.com/*",
    "https://civitai.red/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://civitai.com/*",
        "https://civitai.red/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "feed.html"
      ],
      "matches": [
        "https://civitai.com/*", "https://civitai.red/*"
      ]
    }
  ],
  "action": {
    "default_title": "Open MultiHub for Civitai",
    "default_icon": {
      "16": "icons/multihub-16.png",
      "32": "icons/multihub-32.png",
      "48": "icons/multihub-48.png",
      "128": "icons/multihub-128.png"
    }
  }
}
